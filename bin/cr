#!/usr/bin/env bash
# cr - start Claude Code with switchyard's routing layered on top, for this session only.
#
#   cr [--safe] [any claude flags/args]   chat, with routing (yolo unless --safe)
#   cr agy [--tier T] "task"              hand a task to the Antigravity CLI
#   cr models                             list the models your agy login offers
#   cr route "prompt"                     show the route a prompt would get (no model call)
#   cr usage [--days N]                   tokens per subscription and routes taken
#
# Nothing here touches your global Claude Code config: the plugin, the prompt and the
# model are passed as flags, so plain `claude` (and anything scheduled to run it) is
# unchanged.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
ROOT=$(cd -P "$(dirname "$src")/.." && pwd)

case "${1:-}" in
  agy)    shift; exec python3 "$ROOT/lib/agy.py" "$@" ;;
  models) shift; exec python3 "$ROOT/lib/agy.py" --list "$@" ;;
  usage)  shift; exec python3 "$ROOT/lib/usage.py" "$@" ;;
  route)  shift; exec python3 "$ROOT/plugin/hooks/route.py" --dry-run "$@" ;;
  -h|--help|help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

yolo=1
args=()
for a in "$@"; do
  case "$a" in
    --safe) yolo=0 ;;
    *) args+=("$a") ;;
  esac
done
[ "${CR_SAFE:-0}" = 1 ] && yolo=0

flags=(
  --model "${CR_FRONT_MODEL:-sonnet}"
  --plugin-dir "$ROOT/plugin"
  --append-system-prompt-file "$ROOT/prompts/router.md"
  --autocompact "${CR_AUTOCOMPACT:-160k}"
)
[ "$yolo" = 1 ] && flags+=(--dangerously-skip-permissions)

export CR_ROOT="$ROOT" CR_YOLO="$yolo"
exec claude "${flags[@]}" ${args[@]+"${args[@]}"}
